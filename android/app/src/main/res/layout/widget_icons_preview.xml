<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_icons_background"
    android:gravity="center"
    android:orientation="horizontal">
    <FrameLayout android:layout_width="94dp" android:layout_height="94dp">
        <LinearLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_preview_ring"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT"
                android:textColor="#64E2CC"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Л"
                android:textColor="#EEF5FA"
                android:textSize="22sp" />
        </LinearLayout>
        <TextView
            android:layout_width="28dp"
            android:layout_height="18dp"
            android:layout_gravity="end|bottom"
            android:background="@drawable/widget_icon_badge"
            android:gravity="center"
            android:text="+1"
            android:textColor="#EEF5FA"
            android:textSize="10sp" />
    </FrameLayout>
</LinearLayout>
