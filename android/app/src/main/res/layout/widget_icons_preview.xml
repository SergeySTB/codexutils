<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_icons_background"
    android:gravity="center"
    android:orientation="horizontal">
    <FrameLayout android:layout_width="50dp" android:layout_height="50dp">
        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_preview_ring"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/provider_openai" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/localized_095"
                android:textColor="#EEF5FA"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:layout_width="28dp"
            android:layout_height="18dp"
            android:layout_gravity="end|bottom"
            android:background="@drawable/widget_icon_badge"
            android:gravity="center"
            android:text="+1"
            android:textColor="#EEF5FA"
            android:textSize="10sp" />
    </FrameLayout>
</LinearLayout>
