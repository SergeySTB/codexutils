<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="11dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/widget_card_background">
    <TextView
        android:id="@+id/widget_card_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#EEF5FA"
        android:textStyle="bold"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/widget_card_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AABBC8"
        android:textSize="11sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/localized_013"
            android:textColor="#EEF5FA"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_card_five"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64E2CC"
            android:textSize="15sp" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/widget_card_five_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progressTint="#64E2CC"
        android:progressBackgroundTint="#364153" />
    <TextView
        android:id="@+id/widget_card_five_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#AABBC8"
        android:textSize="11sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/localized_014"
            android:textColor="#EEF5FA"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_card_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B197FA"
            android:textSize="15sp" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/widget_card_week_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progressTint="#B197FA"
        android:progressBackgroundTint="#364153" />
    <TextView
        android:id="@+id/widget_card_week_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#AABBC8"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/widget_card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="#AABBC8"
        android:textSize="11sp" />
</LinearLayout>
