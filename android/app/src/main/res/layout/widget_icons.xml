<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_icons_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_icons_background">
    <LinearLayout
        android:id="@+id/widget_icons_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    <TextView
        android:id="@+id/widget_icons_overflow"
        android:layout_width="54dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textColor="#EEF5FA"
        android:textSize="16sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_icons_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/localized_092"
        android:textColor="#EEF5FA"
        android:textSize="13sp" />
</LinearLayout>
