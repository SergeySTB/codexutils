<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AIUsageMonitor.ico</ApplicationIcon>
    <AssemblyTitle>AI Usage Monitor</AssemblyTitle>
    <Product>AI Usage Monitor</Product>
    <Version>6.4</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../config/config.example.json" Link="config.example.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\provider_openai.png" />
    <Resource Include="Assets\provider_claude.png" />
    <EmbeddedResource Include="Assets\reset_fanfare.wav" />
  </ItemGroup>
</Project>
